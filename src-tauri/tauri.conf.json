{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProtoFlow",
  "version": "0.1.0",
  "identifier": "app.protoflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ProtoFlow",
        "width": 1440,
        "height": 900,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["protoflow"]
      }
    },
    "updater": {
      "endpoints": [
        "https://releases.protoflow.app/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2N0MzMDU5NkQ4NTZFM0QKUldROWJvVnRXVEI4VnNKZExEMVpqVy93VmNZNjdndklTMDNwQlRoenhVNzlhLzNpUEZUNm5lRTQK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["msi", "nsis", "deb", "appimage"],
    "fileAssociations": [
      {
        "ext": ["pflow"],
        "name": "ProtoFlow project",
        "description": "ProtoFlow project file",
        "mimeType": "application/x-protoflow+json"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
