{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProtoFlow",
  "version": "0.1.0",
  "identifier": "app.protoflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ProtoFlow",
        "width": 1440,
        "height": 900,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https: asset: http://asset.localhost; media-src 'self' data: blob: http: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: wss:; frame-src 'self' about: blob: data: https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["script-src", "style-src"],
      "capabilities": ["default", "preview"]
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["protoflow"]
      }
    },
    "updater": {
      "requireSignedVersion": true,
      "endpoints": [
        "https://releases.protoflow.app/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2N0MzMDU5NkQ4NTZFM0QKUldROWJvVnRXVEI4VnNKZExEMVpqVy93VmNZNjdndklTMDNwQlRoenhVNzlhLzNpUEZUNm5lRTQK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["msi", "nsis", "deb", "rpm", "appimage"],
    "category": "GraphicsAndDesign",
    "shortDescription": "Free, local-first prototyping for apps and websites",
    "longDescription": "ProtoFlow is a free, local-first prototyping tool: design screens, link them into clickable prototypes, preview them on any device and export HTML, all on your own computer.",
    "linux": {
      "deb": { "section": "graphics", "priority": "optional" },
      "rpm": { "release": "1" },
      "appimage": { "bundleMediaFramework": false }
    },
    "fileAssociations": [
      {
        "ext": ["pflow"],
        "name": "ProtoFlow project",
        "description": "ProtoFlow project file",
        "mimeType": "application/x-protoflow+json"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
