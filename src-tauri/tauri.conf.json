{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProtoFlow",
  "version": "0.1.0",
  "identifier": "app.protoflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ProtoFlow",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 800,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "deb", "appimage"],
    "fileAssociations": [
      {
        "ext": ["pflow"],
        "name": "ProtoFlow project",
        "description": "ProtoFlow project file",
        "mimeType": "application/x-protoflow+json"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
