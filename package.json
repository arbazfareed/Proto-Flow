{
  "name": "proto-flow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "benchmark:canvas": "node scripts/run-canvas-benchmark.mjs",
    "benchmark:axure-parity": "node scripts/run-axure-parity-benchmark.mjs",
    "benchmark:performance": "npm run build -- --sourcemap && npm run analyze:bundle && npm run benchmark:vitest && npm run benchmark:axure-parity",
    "benchmark:vitest": "vitest bench src/project/performance.bench.ts --reporter=verbose --silent=false",
    "analyze:bundle": "source-map-explorer \"dist/assets/CanvasStage*.js\" \"dist/assets/FlowDiagram*.js\" \"dist/assets/UTIF*.js\" \"dist/assets/heic2any*.js\" \"dist/assets/index*.js\" --no-border-checks --html reports/bundle-map.html",
    "test:axure-parity": "vitest run src/project/axureParityWorkflows.test.ts src/project/dynamicPanels.test.ts src/project/repeaters.test.ts src/project/expressions.test.ts src/project/variables.test.ts src/project/interactions.test.ts src/project/flow.test.ts src/project/widgetNotes.test.ts src/project/richText.test.ts src/project/versionHistory.test.ts src/preview/runtime.test.ts src/preview/publishBundle.test.ts src/preview/codeExport.test.ts src/preview/htmlExport.test.ts",
    "verify:devices": "node scripts/run-device-verification.mjs",
    "qa:exports": "node scripts/run-export-browser-qa.mjs",
    "qa:exports:full": "node scripts/run-export-browser-qa.mjs --full",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:components": "vitest run --config vite.components.config.ts",
    "test:components:ci": "vitest run --config vite.components.config.ts --coverage",
    "test:e2e:browser": "playwright test",
    "build:e2e:desktop": "tauri build --debug --no-bundle",
    "test:e2e:desktop": "wdio run wdio.tauri.conf.mjs",
    "test:e2e": "npm run test:e2e:browser && npm run build:e2e:desktop && npm run test:e2e:desktop"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@sentry/react": "^11.9.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "^2.6.2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "heic2any": "^0.0.4",
    "html-to-image": "^1.11.13",
    "jsondiffpatch": "^0.7.6",
    "jszip": "^3.10.2",
    "konva": "^10.8.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-konva": "^19.3.0",
    "tailwind-merge": "^3.3.1",
    "utif": "^3.1.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.27",
    "zod": "^4.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/utif": "^3.0.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "@wdio/cli": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "@wdio/tauri-service": "^1.5.1",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "source-map-explorer": "^2.5.3",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.4"
  }
}
